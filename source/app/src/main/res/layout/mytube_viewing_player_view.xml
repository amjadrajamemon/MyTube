<?xml version="1.0" encoding="utf-8"?>
<!-- A TextureView is necessary for Compose translucent viewing-mode layers to
     draw reliably ABOVE video on Android TV and AOSP boxes. Use this only for
     Lights Out/Cinema/Night; retain the faster SurfaceView for Normal mode. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
